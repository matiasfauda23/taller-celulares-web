# Server-only settings; never use NEXT_PUBLIC_ for tokens or Redis credentials.
NEST_API_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
APP_ORIGIN=http://localhost:3001
SESSION_COOKIE_SECRET=<AT_LEAST_32_RANDOM_CHARACTERS>
# Only for local verification, where the E2E suite runs the production build over plain HTTP.
# Leave unset in any deployed environment.
# APP_ALLOW_INSECURE_ORIGIN=true
